# Authentication mode for local/stdin use: auto (default), oauth, or service-account.
# In auto mode, service-account credentials win when present; otherwise the
# server reads the local OAuth token created by `play-console-mcp auth login`.
# GOOGLE_PLAY_AUTH_MODE=auto

# Option A: Google user OAuth for local/stdin use
# Download a Desktop OAuth client JSON from Google Cloud and run:
#   npx -y github:alsd4git/play-console-mcp auth login --client /path/to/client_secret.json
# Optional overrides:
# GOOGLE_OAUTH_CLIENT_CONFIG_PATH=/path/to/client_secret.json
# GOOGLE_OAUTH_TOKEN_PATH=/path/to/google-oauth.json
# GOOGLE_OAUTH_CLIENT_ID=client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=client-secret

# Option B: Google Play service account key for local/stdin use
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# Optional default app, so tools can omit package_name
GOOGLE_PLAY_PACKAGE_NAME=com.example.app

# Tool profile. `full` preserves upstream behavior and is the packaged plugin
# default; `readonly` exposes only the reviewed read-only allowlist.
# GOOGLE_PLAY_PROFILE=full
# Legacy-style boolean alias:
# GOOGLE_PLAY_READ_ONLY=1

# Optional defense in depth: only allow these package names. When set,
# list_apps is hidden because it could reveal apps outside the allowlist.
# GOOGLE_PLAY_ALLOWED_PACKAGES=com.example.app,com.example.second

# Optional: register delete, listing image upload and app recovery write tools.
# Standard writes (review replies, listing edits, release/rollout/tester changes)
# do NOT need this flag. APK/AAB uploads are not implemented by this MCP.
# GOOGLE_PLAY_ALLOW_DESTRUCTIVE=1

# -----------------------------------------------------------------------------
# Remote ChatGPT/Codex app mode: `play-console-mcp serve --http`
# -----------------------------------------------------------------------------
# The public MCP resource URL seen by ChatGPT. With Secure MCP Tunnel this is
# the tunnel's HTTPS /mcp URL while the local listener can remain 127.0.0.1.
# MCP_PUBLIC_URL=https://play-mcp.example.com/mcp

# High-entropy secret used to sign MCP access/refresh tokens and derive the key
# that encrypts Google refresh tokens at rest. Generate with:
#   npx -y github:alsd4git/play-console-mcp remote secret
# MCP_OAUTH_SECRET=replace-with-generated-secret

# Remote mode requires a Google OAuth client of type Web application.
# Its authorized redirect URI must include:
#   https://play-mcp.example.com/oauth/google/callback
# GOOGLE_OAUTH_CLIENT_CONFIG_PATH=/path/to/web-client.json
# Or provide the Web client directly:
# GOOGLE_OAUTH_CLIENT_ID=client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=client-secret
# GOOGLE_OAUTH_REDIRECT_URI=https://play-mcp.example.com/oauth/google/callback

# Remote access is closed by default. For private use, list the Google accounts
# that may connect. To intentionally run a multi-user server instead, opt in to
# accepting any Google account with MCP_OAUTH_ALLOW_ANY_GOOGLE_ACCOUNT=1.
# GOOGLE_OAUTH_ALLOWED_EMAILS=you@example.com
# MCP_OAUTH_ALLOW_ANY_GOOGLE_ACCOUNT=0

# Local HTTP listener. Loopback is the safe default for Secure MCP Tunnel.
# A non-loopback bind additionally requires MCP_HTTP_ALLOW_PUBLIC_BIND=1.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8787
# MCP_HTTP_ALLOW_PUBLIC_BIND=0

# Optional persistent remote identity store. Google refresh tokens are encrypted
# before they are written here. Never commit this file.
# MCP_OAUTH_DATA_PATH=/path/to/remote-oauth.json

# Advanced deployment overrides. HTTPS is required unless explicit development
# mode is enabled for loopback/private testing.
# MCP_OAUTH_ISSUER=https://play-mcp.example.com
# MCP_ALLOW_INSECURE_HTTP=0
