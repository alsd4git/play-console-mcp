{
  "name": "@orellbuehler/play-console-mcp",
  "version": "0.3.0",
  "description": "Model Context Protocol server for Google Play Console with service-account and local Google OAuth support",
  "type": "module",
  "bin": {
    "play-console-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    ".mcp.json",
    ".codex-plugin",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build",
    "auth": "node dist/index.js auth"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-play",
    "play-console",
    "android",
    "androidpublisher",
    "reviews",
    "releases",
    "llm",
    "ai",
    "openai",
    "codex",
    "chatgpt",
    "oauth"
  ],
  "author": "Orell Bühler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrellBuehler/play-console-mcp.git"
  },
  "homepage": "https://github.com/OrellBuehler/play-console-mcp#readme",
  "bugs": {
    "url": "https://github.com/OrellBuehler/play-console-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "jose": "^6.0.11",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.0"
  }
}
